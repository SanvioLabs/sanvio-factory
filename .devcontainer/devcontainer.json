{
  "name": "Sanvio Factory",
  "build": {"dockerfile": "Dockerfile"},
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },
  "mounts": [
    "source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=gh-config-${devcontainerId},target=/home/vscode/.config/gh,type=volume"
  ],
  "containerEnv": {"CLAUDE_CONFIG_DIR": "/home/vscode/.claude"},
  "postCreateCommand": "git config core.hooksPath .githooks && python3 scripts/check_setup.py"
}
