+#!/usr/bin/env python3
+"""Print every skill in skills/ with its description.
+
+Usage:
+    python3 scripts/list_skills.py
+"""
+import re
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parent.parent
+DESCRIPTION = re.compile(r"^description: (.+)$", re.M)
+
+
+def skills(root=ROOT):
+    found = []
+    for path in sorted((root / "skills").glob("*/SKILL.md")):
+        match = DESCRIPTION.search(path.read_text())
+        found.append((path.parent.name, match.group(1) if match else "(no description)"))
+    return found
+
+
+if __name__ == "__main__":
+    for name, description in skills():
+        print("{:<16} {}".format(name, description))
